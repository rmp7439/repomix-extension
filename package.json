{
  "name": "reposync",
  "displayName": "RepoSync",
  "description": "Automatically regenerate a repomix-packed context file on git push",
  "version": "0.0.3",
  "publisher": "rmp7439",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rmp7439/repomix-extension.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "reposync.selectOutputFile",
        "title": "RepoSync: Select Output File"
      },
      {
        "command": "reposync.toggle",
        "title": "RepoSync: Toggle"
      },
      {
        "command": "reposync.forceRun",
        "title": "RepoSync: Force Regenerate Now"
      },
      {
        "command": "reposync.simulateTrigger",
        "title": "RepoSync: Simulate Push Event"
      },
      {
        "command": "reposync.showLog",
        "title": "RepoSync: Show Log"
      },
      {
        "command": "reposync.runSmokeTest",
        "title": "RepoSync: Run Smoke Test"
      }
    ],
    "configuration": {
      "title": "RepoSync",
      "properties": {
        "reposync.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic regeneration on git push"
        },
        "reposync.outputFileName": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "The exact name of the repomix output file (e.g., repo.txt). If not set, the extension will attempt to auto-detect it."
        },
        "reposync.style": {
          "type": "string",
          "enum": ["plain", "xml", "markdown"],
          "default": "plain",
          "description": "Output style format"
        },
        "reposync.remote": {
          "type": "string",
          "default": "origin",
          "description": "Primary remote to watch for pushes"
        },
        "reposync.debounceMs": {
          "type": "number",
          "default": 750,
          "description": "Debounce window in milliseconds for rapid consecutive pushes"
        },
        "reposync.pollIntervalMs": {
          "type": "number",
          "default": 3000,
          "description": "Interval in milliseconds to poll the git ref file as a backup mechanism (useful for OneDrive/Dropbox synced folders where native watching fails)"
        },
        "reposync.notifyOnSync": {
          "type": "boolean",
          "default": false,
          "description": "Show a notification toast in addition to the status bar update"
        },
        "reposync.autoGitignore": {
          "type": "boolean",
          "default": true,
          "description": "Automatically offer to add the output file to .gitignore"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "18.x",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "repomix": "^0.2.14"
  }
}
